<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ローカルの PostgreSQL の接続文字列は、ユーザーシークレットに置く（secrets.template.json を参照） -->
    <UserSecretsId>flowhub-integration-tests</UserSecretsId>

    <!-- ローカルの PostgreSQL を使うので、ふだんの dotnet test には含めない（流し方は CLAUDE.md を参照） -->
    <IsTestProject Condition="'$(RunIntegrationTests)' != 'true'">false</IsTestProject>
    <IsTestingPlatformApplication Condition="'$(RunIntegrationTests)' != 'true'">false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FlowHub.Api\FlowHub.Api.csproj" />
  </ItemGroup>

</Project>
